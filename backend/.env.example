# Remo North Local Government E-Portal Backend Configuration
SECRET_KEY=remo-north-local-government-secret-key-super-secure-2026
JWT_SECRET_KEY=remo-north-jwt-token-signing-key-secret-2026

# Database configuration (Defaults to SQLite in instance/egovern.sqlite if omitted)
# For production PostgreSQL (e.g. Render Postgres, Supabase, Neon):
# DATABASE_URL=postgresql://user:password@host:5432/remo_north_db

# CORS Allowed Origins (comma-separated, or * for open access)
CORS_ORIGINS=*

# Cloudinary Storage Configuration (Optional - fallback saves to backend/static/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
